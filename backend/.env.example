# Environment Configuration for PriceWise Backend
PROJECT_NAME="PriceWise"
ENVIRONMENT="development"
DEBUG=True
API_V1_PREFIX="/api/v1"

# Database Configuration (SQLite default for development, PostgreSQL-ready)
DATABASE_URL="sqlite+aiosqlite:///./pricewise.db"
DATABASE_URL_SYNC="sqlite:///./pricewise.db"

# Security & Authentication
SECRET_KEY="replace_with_secure_random_secret_in_production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Google Gemini AI Configuration
# The key should be provided by the environment or .env file
GEMINI_API_KEY="your-gemini-api-key-here"
GEMINI_MODEL="gemini-3.5-flash-lite"

# CORS Configuration
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Marketplace Scraping / Rate Limiting (seconds between requests)
MARKETPLACE_REQUEST_TIMEOUT=15
MARKETPLACE_RATE_LIMIT_DELAY=2.0
ENABLE_DEMO_DATA=True
